# Copie ce fichier en .env pour changer les valeurs par défaut (facultatif).

# Port local où le jeu répond, en HTTP. Ton reverse proxy (domaine, HTTPS) pointe dessus :
#   jeu.exemple.fr {
#       reverse_proxy 127.0.0.1:8080
#   }
PORT=8080

# Interface d'écoute. 127.0.0.1 : la machine seulement (recommandé derrière un proxy).
# 0.0.0.0 : tout le réseau (essai sur le wifi de la maison, ou proxy sur une autre machine).
BIND_ADDRESS=127.0.0.1
