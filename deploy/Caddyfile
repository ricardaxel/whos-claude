# Point d'entrée du jeu, en HTTP simple : le domaine et le HTTPS sont gérés par ton propre
# reverse proxy, devant (par exemple : reverse_proxy 127.0.0.1:8080). Ce Caddy-ci sert le
# client et fait suivre /colyseus au serveur de jeu.
{
	auto_https off
	admin off
	servers {
		# Le proxy de devant est sur la machine (ou le réseau Docker) : on croit l'adresse du
		# joueur qu'il transmet dans X-Forwarded-For. Le port n'est publié que sur 127.0.0.1 :
		# personne d'autre ne peut se faire passer pour lui. En mode strict, l'en-tête est lu
		# de droite à gauche : une adresse ajoutée par le joueur lui-même est ignorée.
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80

encode zstd gzip

# En-têtes de sécurité, sur toutes les réponses.
header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	# Le jeu ne charge que ses propres fichiers (police comprise) ; les WebSockets vont vers
	# la même origine. « unsafe-inline » pour les styles : la page en contient.
	Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	-Server
}

# Serveur de jeu : HTTP (matchmaking) et WebSockets, préfixe /colyseus retiré.
handle_path /colyseus/* {
	# Les requêtes du matchmaking sont minuscules : un corps énorme ne doit jamais atteindre
	# le serveur de jeu (il le garderait en mémoire).
	request_body {
		max_size 16KB
	}
	reverse_proxy game:2567 {
		# Adresse réelle du joueur, pour les limites par IP du serveur (il ne voit que Caddy) :
		# celle transmise par ton proxy, sinon celle de la connexion.
		header_up X-Real-IP {client_ip}
	}
}

# Client : fichiers construits par Vite. Les fichiers de /assets portent un hash dans leur
# nom (cache long) ; la page elle-même est toujours revalidée, pour voir les mises à jour.
handle {
	root * /srv
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @assets -Last-Modified
	@page path / /index.html
	header @page Cache-Control "no-cache"
	file_server
}
